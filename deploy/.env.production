# ============================================================
# 生产环境配置 — 部署前必须修改所有 CHANGE_ME 值
# 启动时后端 runtime_security 会强制校验：占位符/长度不足会拒绝启动
#
# 一次性生成全部秘钥：
#   echo "DB_PASSWORD=$(openssl rand -base64 24 | tr -d '=+/')"
#   echo "JWT_SECRET=$(openssl rand -hex 48)"
#   echo "JWT_REFRESH_SECRET=$(openssl rand -hex 48)"
#   echo "S3_ACCESS_KEY=$(openssl rand -base64 18 | tr -d '=+/')"
#   echo "S3_SECRET_KEY=$(openssl rand -base64 36 | tr -d '=+/')"
# ============================================================

# 你的主域名（不带 https://，例如 zhefenglin.com）
# 部署脚本会自动把 www.<DOMAIN> 一并纳入证书，并统一 301 跳转回裸域
DOMAIN=your-domain.com

# ──── 镜像构建源（可选）────
# 中国大陆服务器建议保留阿里云 PyPI 镜像；海外 / CI 可改回 https://pypi.org/simple 并清空 trusted host
BACKEND_PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
BACKEND_PIP_TRUSTED_HOST=mirrors.aliyun.com

# ──── 数据库 ────
DB_USER=app
# 要求：强随机 ≥ 24 字符；禁止使用 app / postgres / root 等常见弱密
DB_PASSWORD=CHANGE_ME_db_password_here
DB_NAME=auto_finance

# ──── JWT 密钥（必须 ≥ 64 字符；用 openssl rand -hex 48 生成） ────
# 两把密钥必须不同，切勿复用
JWT_SECRET=CHANGE_ME_jwt_secret_here
JWT_REFRESH_SECRET=CHANGE_ME_jwt_refresh_secret_here

# ──── MinIO / S3 存储 ────
# 禁止使用 minioadmin / admin / root 等默认凭据
S3_ACCESS_KEY=CHANGE_ME_minio_access
S3_SECRET_KEY=CHANGE_ME_minio_secret
S3_BUCKET=auto-finance
# 若对象存储有公网下载域名，再填写；留空时下载/预览统一经后端代理，避免 mixed content
S3_PUBLIC_BASE_URL=

# ──── 车300 API ────
CHE300_ACCESS_KEY=your_che300_key
CHE300_ACCESS_SECRET=your_che300_secret
CHE300_API_BASE=https://cloud-api.che300.com
DEFAULT_CITY_CODE=320100
DEFAULT_CITY_NAME=南京

# ──── DeepSeek LLM（可选，留空则用 Mock） ────
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ──── 注册与合规 ────
# 内测期强烈建议保留 false：公开 /api/auth/register 关闭，
# 访客走 /api/auth/access-request 申请制，admin 手工审批后用
# scripts/create_admin.py 开通账号。
ALLOW_PUBLIC_REGISTRATION=false
# 当前服务条款版本号；每次修改 /legal/notice 文案时递增
TERMS_VERSION=2026.04.21
# 公开注册开启时，新用户会进入这个默认租户；内测/POC 可改成对应租户 code/name
DEFAULT_REGISTRATION_TENANT_CODE=default
DEFAULT_REGISTRATION_TENANT_NAME=默认租户
