# ============================================================
# 后端环境变量示例
# 复制为 ../.env 后填入实际值（后端从项目根 .env 加载）
#
# 生产环境强制要求（APP_ENV=production 时会由 runtime_security 校验）:
#   - JWT_SECRET / JWT_REFRESH_SECRET ≥ 64 字符、不含占位符
#     推荐生成：openssl rand -hex 48
#   - DATABASE_URL 不能使用 app:app / postgres:postgres / root:root 等默认凭据
#   - CORS_ORIGINS 不能为 *、不能包含 localhost、必须 https://
#   - STORAGE_BACKEND 必须为 s3，且 S3 凭据非占位符
#   - RATE_LIMIT_ENABLED=true
# ============================================================

# Database — PostgreSQL (生产)
# 开发默认；生产请改 app:<强随机>@postgres:5432/auto_finance
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/auto_finance
APP_ENV=development

# Legacy SQLite note:
# backend/data/npl.db 仅供历史数据查看，不再作为应用运行时入口

# Redis (Task 8 起需要)
REDIS_URL=redis://localhost:6379/0

# Auth — 生产环境必须用 openssl rand -hex 48 生成，长度 ≥ 64
# 两把 secret 必须不同。切勿提交真实值到仓库。
JWT_SECRET=change-me-to-random-string
JWT_REFRESH_SECRET=change-me-to-another-random-string
DEFAULT_REGISTRATION_TENANT_CODE=default
DEFAULT_REGISTRATION_TENANT_NAME=默认租户

# CORS — 生产仅允许 https 主域名，逗号分隔；禁止 *、localhost
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_MAX_REQUESTS=10
RATE_LIMIT_REGISTER_MAX_REQUESTS=5
RATE_LIMIT_WRITE_MAX_REQUESTS=30

# File Storage — 生产必须改为 s3 并填 S3/MinIO 凭据
STORAGE_BACKEND=local
# S3_ENDPOINT=http://minio:9000
# S3_PUBLIC_BASE_URL=https://files.example.com
# S3_BUCKET=auto-finance
# S3_ACCESS_KEY=（openssl rand -base64 24 生成，禁止使用 minioadmin）
# S3_SECRET_KEY=（openssl rand -base64 36 生成，禁止使用 minioadmin）

# 车300 API
CHE300_ACCESS_KEY=your_access_key
CHE300_ACCESS_SECRET=your_secret_key
CHE300_API_BASE=https://cloud-api.che300.com
DEFAULT_CITY_CODE=320100
DEFAULT_CITY_NAME=南京

# DeepSeek LLM
DEEPSEEK_API_KEY=your_deepseek_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
